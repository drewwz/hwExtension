{
  "manifest_version": 3,
  "name": "开售点按",
  "version": "1.3.0",
  "description": "开售点按，或守退单补货：有货就选典藏版和有货颜色并提交。进入支付页后循环响铃。不代付款。",
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": [
    "https://vmall.com/*",
    "https://*.vmall.com/*"
  ],
  "action": {
    "default_title": "开售点按",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://vmall.com/*", "https://*.vmall.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
